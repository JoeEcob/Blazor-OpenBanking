@page "/analytics"
@using Spendy.Components.Shared
@rendermode RenderMode.InteractiveServer

@inject AccountLoader _accountLoader
@inject CreditCardLoader _creditCardLoader
@inject TransactionLoader _transactionLoader
@inject CreditCardTransactionLoader _creditCardTransactionLoader

<div class="analytics-container">
    <h1>Analytics</h1>

    @if (isLoading)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <AccountBar SelectedAccountId="@selectedAccountId"
                    OnAccountSelected="@(e => FetchTransactions(e.AuthId, e.AccountId))"
                    OnCardSelected="@(e => FetchCardTransactions(e.AuthId, e.AccountId))" />


        @if (!string.IsNullOrEmpty(selectedAccountId) && transactions?.Length > 0)
        {
            <div class="summary-stats">
                <div class="stat-card">
                    <h4>Total Transactions</h4>
                    <p>@transactions.Length</p>
                </div>
                <div class="stat-card">
                    <h4>Total Spent</h4>
                    <p>@transactions.Where(t => t.Amount < 0).Sum(t => t.Amount).ToString("C")</p>
                </div>
                <div class="stat-card">
                    <h4>Total Income</h4>
                    <p>@transactions.Where(t => t.Amount > 0).Sum(t => t.Amount).ToString("C")</p>
                </div>
                <div class="stat-card">
                    <h4>Average Transaction</h4>
                    <p>@(transactions.Length > 0 ? (transactions.Sum(t => t.Amount) / transactions.Length).ToString("C") : "£0.00")</p>
                </div>
            </div>

            <div class="charts-grid">
                <div class="chart-card">
                    <h3>Spending Over Time</h3>
                    <ApexChart TItem="TransactionPoint"
                               @ref="spendingChart"
                               Options="spendingChartOptions">
                        <ApexPointSeries TItem="TransactionPoint"
                                       Items="spendingData"
                                       Name="Amount"
                                       XValue="@(e => e.Date)"
                                       YValue="@(e => (decimal)e.Amount)" />
                    </ApexChart>
                </div>

                <div class="chart-card">
                    <h3>Spending by Day</h3>
                    <ApexChart TItem="DailySpending"
                               @ref="dailyChart"
                               Options="dailyChartOptions">
                        <ApexPointSeries TItem="DailySpending"
                                       Items="dailyData"
                                       Name="Total"
                                       XValue="@(e => e.Day)"
                                       YValue="@(e => (decimal)e.Total)" />
                    </ApexChart>
                </div>

                <div class="chart-card">
                    <h3>Monthly Summary</h3>
                    <ApexChart TItem="MonthlySummary"
                               @ref="monthlyChart"
                               Options="monthlyChartOptions">
                        <ApexPointSeries TItem="MonthlySummary"
                                       Items="monthlyData"
                                       Name="Income"
                                       XValue="@(e => e.Month)"
                                       YValue="@(e => (decimal)e.Income)" />
                        <ApexPointSeries TItem="MonthlySummary"
                                       Items="monthlyData"
                                       Name="Expenses"
                                       XValue="@(e => e.Month)"
                                       YValue="@(e => (decimal)e.Expenses)" />
                    </ApexChart>
                </div>

                <div class="chart-card">
                    <h3>Spending Distribution</h3>
                    <ApexChart TItem="CategorySpending"
                               @ref="categoryChart"
                               Options="categoryChartOptions">
                        <ApexPointSeries TItem="CategorySpending"
                                       Items="categoryData"
                                       Name="Amount"
                                       XValue="@(e => e.Category)"
                                       YValue="@(e => (decimal)e.Amount)" />
                    </ApexChart>
                </div>
            </div>
        }
        else
        {
            <p>No transactions available for this account.</p>
        }
    }
</div>

@code {
    private bool isLoading = true;
    private string selectedAccountId = "";
    private Account[] accounts = new Account[0];
    private Card[] creditCards = new Card[0];
    private Transaction[] transactions = new Transaction[0];

    private ApexChart<TransactionPoint> spendingChart;
    private ApexChart<DailySpending> dailyChart;
    private ApexChart<MonthlySummary> monthlyChart;
    private ApexChart<CategorySpending> categoryChart;

    private ApexChartOptions<TransactionPoint> spendingChartOptions;
    private ApexChartOptions<DailySpending> dailyChartOptions;
    private ApexChartOptions<MonthlySummary> monthlyChartOptions;
    private ApexChartOptions<CategorySpending> categoryChartOptions;

    private List<TransactionPoint> spendingData = new();
    private List<DailySpending> dailyData = new();
    private List<MonthlySummary> monthlyData = new();
    private List<CategorySpending> categoryData = new();

    protected override async Task OnInitializedAsync()
    {
        accounts = await _accountLoader.Load();
        creditCards = await _creditCardLoader.Load();

        if (accounts.Any())
        {
            var firstAccount = accounts.First();
            await FetchTransactions(firstAccount.AuthId, firstAccount.AccountId);
        }

        isLoading = false;

        InitializeChartOptions();
    }

    private void InitializeChartOptions()
    {
        spendingChartOptions = new ApexChartOptions<TransactionPoint>
        {
            Chart = new Chart { Type = ChartType.Line },
            Title = new Title { Text = "" },
            Xaxis = new XAxis { Type = XAxisType.Datetime },
            Yaxis = new List<YAxis> { new YAxis { Title = new AxisTitle { Text = "Amount (£)" } } }
        };

        dailyChartOptions = new ApexChartOptions<DailySpending>
        {
            Chart = new Chart { Type = ChartType.Bar },
            Title = new Title { Text = "" },
            Xaxis = new XAxis { Type = XAxisType.Category },
            Yaxis = new List<YAxis> { new YAxis { Title = new AxisTitle { Text = "Total (£)" } } }
        };

        monthlyChartOptions = new ApexChartOptions<MonthlySummary>
        {
            Chart = new Chart { Type = ChartType.Line },
            Title = new Title { Text = "" },
            Xaxis = new XAxis { Type = XAxisType.Category },
            Yaxis = new List<YAxis> { new YAxis { Title = new AxisTitle { Text = "Amount (£)" } } }
        };

        categoryChartOptions = new ApexChartOptions<CategorySpending>
        {
            Chart = new Chart { Type = ChartType.Pie },
            Title = new Title { Text = "" },
            Legend = new Legend { Position = LegendPosition.Right }
        };
    }

    private async Task FetchTransactions(Guid authId, string accountId)
    {
        selectedAccountId = accountId;
        transactions = await _transactionLoader.Load(authId, accountId);

        UpdateCharts();
        await RefreshCharts();
    }

    private async Task FetchCardTransactions(Guid authId, string accountId)
    {
        selectedAccountId = accountId;
        transactions = await _creditCardTransactionLoader.Load(authId, accountId);

        UpdateCharts();
        await RefreshCharts();
    }

    private async Task RefreshCharts()
    {
        if (spendingChart != null)
            await spendingChart.UpdateSeriesAsync(true);
        if (dailyChart != null)
            await dailyChart.UpdateSeriesAsync(true);
        if (monthlyChart != null)
            await monthlyChart.UpdateSeriesAsync(true);
        if (categoryChart != null)
            await categoryChart.UpdateSeriesAsync(true);
    }

    private void UpdateCharts()
    {
        // Spending over time (line chart)
        spendingData = transactions
            .OrderBy(t => t.Timestamp)
            .Select(t => new TransactionPoint { Date = t.Timestamp.ToString("yyyy-MM-dd"), Amount = t.Amount })
            .ToList();

        // Daily spending (bar chart)
        dailyData = transactions
            .GroupBy(t => t.Timestamp.Date)
            .OrderBy(g => g.Key)
            .Select(g => new DailySpending
            {
                Day = g.Key.ToString("MMM dd"),
                Total = g.Where(t => t.Amount < 0).Sum(t => Math.Abs(t.Amount))
            })
            .ToList();

        // Monthly summary (line chart with income/expenses)
        monthlyData = transactions
            .GroupBy(t => t.Timestamp.ToString("yyyy-MM"))
            .OrderBy(g => g.Key)
            .Select(g => new MonthlySummary
            {
                Month = g.Key,
                Income = g.Where(t => t.Amount > 0).Sum(t => t.Amount),
                Expenses = Math.Abs(g.Where(t => t.Amount < 0).Sum(t => t.Amount))
            })
            .ToList();

        // Category spending (pie chart - first 5 characters of description)
        categoryData = transactions
            .Where(t => t.Amount < 0)
            .GroupBy(t => t.Description.Substring(0, Math.Min(15, t.Description.Length)))
            .Select(g => new CategorySpending
            {
                Category = g.Key,
                Amount = Math.Abs(g.Sum(t => t.Amount))
            })
            .OrderByDescending(c => c.Amount)
            .Take(10)
            .ToList();
    }

    private class TransactionPoint
    {
        public string Date { get; set; }
        public decimal Amount { get; set; }
    }

    private class DailySpending
    {
        public string Day { get; set; }
        public decimal Total { get; set; }
    }

    private class MonthlySummary
    {
        public string Month { get; set; }
        public decimal Income { get; set; }
        public decimal Expenses { get; set; }
    }

    private class CategorySpending
    {
        public string Category { get; set; }
        public decimal Amount { get; set; }
    }
}
