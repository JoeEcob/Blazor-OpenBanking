@page "/"
@using Spendy.Components.Shared
@rendermode InteractiveServer

@inject AuthService _authService
@inject AccountLoader _accountLoader
@inject CreditCardLoader _creditCardLoader
@inject TransactionLoader _transactionLoader
@inject CreditCardTransactionLoader _creditCardTransactionLoader

<div class="dashboard">
    <h1>Transactions</h1>

    @if (isLoading)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <div class="add-new">
            <a href=@_authService.GetAuthUrl()>Add new account</a>
        </div>

        <AccountBar SelectedAccountId="@selectedAccountId"
                    OnAccountSelected="@(e => FetchTransactions(e.AuthId, e.AccountId))"
                    OnCardSelected="@(e => FetchCardTransactions(e.AuthId, e.AccountId))" />

        <div class="dashboard-transactions">
            @if (isFetching)
            {
                <p><em>Loading...</em></p>
            }
            else
            {
                int previousMonth = -1;
                <Virtualize Items="transactions" Context="transaction">
                    <div @key="transaction.Id">
                        @if (transaction.Timestamp.Month != previousMonth)
                        {
                            previousMonth = transaction.Timestamp.Month;
                            <h3 class="transaction-title">@transaction.Timestamp.ToString("MMMM yyyy")</h3>
                        }

                        <div class="transaction">
                            <span class="date" title="@transaction.Timestamp.ToString("G")">@transaction.Timestamp.ToString("d MMM")</span>
                            <span class="description">@transaction.Description</span>
                            <span class="amount @(transaction.TransactionType.ToLower())">
                                @transaction.Amount.ToString("C")
                            </span>
                            <span class="running-balance">
                                @transaction.RunningBalance?.Amount.ToString("C")
                            </span>
                        </div>
                    </div>
                </Virtualize>
            }
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private bool isFetching = false;
    private string selectedAccountId;
    private Account[] accounts = new Account[0];
    private Card[] creditCards = new Card[0];
    private Transaction[] transactions = new Transaction[0];

    protected override async Task OnInitializedAsync()
    {
        isLoading = false;

        // TODO - stop this getting hit twice on pre-render
        accounts = await _accountLoader.Load();
        creditCards = await _creditCardLoader.Load();

        if (accounts.Any())
        {
            var firstAccount = accounts.First();
            await FetchTransactions(firstAccount.AuthId, firstAccount.AccountId);
        }
    }

    private async Task FetchTransactions(Guid authId, string accountId)
    {
        isFetching = true;
        selectedAccountId = accountId;
        transactions = await _transactionLoader.Load(authId, accountId);
        isFetching = false;
    }

    private async Task FetchCardTransactions(Guid authId, string accountId)
    {
        isFetching = true;
        selectedAccountId = accountId;
        transactions = await _creditCardTransactionLoader.Load(authId, accountId);
        isFetching = false;
    }
}
